# ==========================================
# FraudShield Root .gitignore
# ==========================================

# Large Datasets (GitHub 100MB limit)
benchmarks/**/*.csv
benchmarks/**/*.zip
*.csv
!data/sample_statement.csv
!data/sample_transactions.csv
!benchmarks/**/ieee_cis_model_comparison.csv
!benchmarks/**/model_comparison_results.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.matplotlib_cache/

# Node / Frontend / Mobile
node_modules/
frontend/node_modules/
mobile/node_modules/
.next/
frontend/.next/
.expo/
mobile/.expo/
frontend/out/
mobile/dist/
mobile/web-build/

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & Editor caches
.obsidian/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
